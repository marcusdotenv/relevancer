FROM python:3.12-slim

ARG TARGETARCH
ARG PROMTAIL_VERSION=2.9.0

#promtail config
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl unzip && \
    curl -fsSLO "https://github.com/grafana/loki/releases/download/v${PROMTAIL_VERSION}/promtail-linux-${TARGETARCH}.zip" && \
    unzip promtail-linux-${TARGETARCH}.zip && \
    chmod a+x promtail-linux-${TARGETARCH} && \
    mv promtail-linux-${TARGETARCH} /usr/local/bin/promtail && \
    rm promtail-linux-${TARGETARCH}.zip && \
    rm -rf /var/lib/apt/lists/*
COPY promtail-config.yml /etc/promtail/promtail-config.yml

# python project
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .


EXPOSE 8000
# The protobuff serializer file is generated at startup, not at build time:
# the dev volume mounted over /app would hide a file generated in the image.
CMD ["sh", "-c", "sh generate_proto.sh && fastapi dev ./src/application/http/main.py --host 0.0.0.0 > /var/log/api-python.log 2>&1 & promtail -config.file=/etc/promtail/promtail-config.yml"]
